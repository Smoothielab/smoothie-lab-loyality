# Copia este archivo como .env y llena los valores reales.
# NUNCA subas el .env al repositorio: contiene secretos.

# Puerto del servidor
PORT=3000

# Apple Wallet — PassKit
PASS_TYPE_IDENTIFIER=pass.com.smoothielab.loyalty
# Team ID de Apple Developer (el que va en pass.json como teamIdentifier)
APPLE_TEAM_ID=REEMPLAZAR
# Ruta al certificado Pass Type ID (.p12) y su contraseña
PASS_CERT_PATH=./certs/pass-cert.p12
PASS_CERT_PASSWORD=REEMPLAZAR
# Ruta al certificado WWDR de Apple (.pem)
WWDR_CERT_PATH=./certs/WWDR.pem

# Apple Push Notification service (APNs) — para avisar al iPhone cuando cambia el pase
APNS_KEY_ID=REEMPLAZAR
APNS_TEAM_ID=REEMPLAZAR
APNS_KEY_PATH=./certs/AuthKey.p8
# production = true en producción; false usa el entorno sandbox de APNs
APNS_PRODUCTION=false

# Dominio público del servidor (HTTPS obligatorio para Apple Wallet)
INSTALL_DOMAIN=https://lealtad.smoothielab.mx

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=REEMPLAZAR
GOOGLE_APPLICATION_CREDENTIALS=./certs/google-service-account.json
